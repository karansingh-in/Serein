{
  "manifest_version": 2,
  "name": "YT Keyword Blocker",
  "version": "2.0.0",
  "description": "A small, local-only YouTube keyword and focus extension with distraction controls, focus presets, playback preferences, active viewing-time awareness, Shorts handling, and recreation scheduling.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "matcher.js",
        "distractions.js",
        "playback.js",
        "time-awareness.js",
        "presets.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ytkb@karansingh-in",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "author": "karansingh-in",
  "homepage_url": "https://github.com/karansingh-in",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
